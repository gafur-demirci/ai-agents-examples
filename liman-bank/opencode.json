{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "wiro": {
      "type": "remote",
      "url": "https://mcp.wiro.ai/v1",
      "headers": {
        "Authorization": "{env:WIRO_API_KEY}:{env:WIRO_API_SECRET}"
      },
      "oauth": false,
      "enabled": true
    },
    "vercel": {
      "type": "remote",
      "url": "https://mcp.vercel.com"
    },
    "figma": {
      "type": "local",
      "url": "http://127.0.0.1:3845/mcp"
    }
  }
}